<?xml version="1.0"?>
<package format="3">
  <name>medusa_auv</name>
  <version>0.1.0</version>
  <description>AUV nodes for MedusaRobotics — camera, inference, servo, telemetry</description>
  <maintainer email="abigail@medusarobotics.dev">Abigail</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>medusa_msgs</depend>
  <depend>python3-websockets</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <buildtool_depend>ament_python</buildtool_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
